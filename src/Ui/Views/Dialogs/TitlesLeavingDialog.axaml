<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.Views.Dialogs"
        x:Class="CircuitRF.Ui.Views.Dialogs.TitlesLeavingDialog"
        Title="What Is About To Leave"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto" >

    <!-- R-rc11-17. The expensive case is not a careless word: it is a customer's name or a part
         number in a title going to a DIFFERENT customer, and nobody can recall from memory what forty
         titles say. §9A.3 already establishes that a computation the user cannot perform belongs in
         front of the operation. -->
    <TextBlock Grid.Row="0" x:Name="HeadingText" TextWrapping="Wrap" FontWeight="SemiBold" />

    <!-- R-rc11-18. On the archive this composes with §9A.3's own warning rather than replacing it:
         that one is about FILES the history still holds after they were deleted from the workspace,
         this one is about TITLES. Both are true and they are about different things. -->
    <TextBlock Grid.Row="1" x:Name="FileWarningText" TextWrapping="Wrap" FontSize="11"
               Margin="0,8,0,0" IsVisible="False" Opacity="0.9" />

    <Border Grid.Row="2" Margin="0,10" BorderThickness="1" CornerRadius="3"
            BorderBrush="{DynamicResource SystemBaseLowColor}">
      <ScrollViewer>
        <ItemsControl x:Name="Titles">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LeavingTitleRow">
              <Grid ColumnDefinitions="110,*,Auto" Margin="8,4">
                <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="11" Opacity="0.6"
                           FontFamily="monospace" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Shown}" TextWrapping="Wrap" />
                  <!-- A corrected title shows the correction AND what it corrects. The review is the
                       one place a sender is deciding what the other side reads, so the pair is the
                       answer and the correction alone would be half of it. -->
                  <TextBlock Text="{Binding OriginalNote}" FontSize="10" Opacity="0.65"
                             TextWrapping="Wrap" IsVisible="{Binding HasCorrection}" />
                  <TextBlock Text="{Binding Who}" FontSize="10" Opacity="0.55"
                             IsVisible="{Binding ShowAuthor}" />
                </StackPanel>

                <!-- R-rc11-19. THE CORRECTION IS REACHABLE FROM HERE. The useful response to reading a
                     bad title is fixing it, not abandoning the send — so the fix is on the row that
                     showed the problem rather than in a panel behind this window. -->
                <Button Grid.Column="2" Content="Correct…" Click="OnCorrectRow"
                        VerticalAlignment="Top" Padding="8,2" FontSize="11" Margin="8,0,0,0"
                        IsVisible="{Binding CanCorrect}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- R-rc11-19. IT IS NOT A CONFIRMATION PROMPT WITH A CHECKBOX. The useful response to reading a
         bad title is fixing it, not abandoning the send — so the line under the list says where the
         correction lives, and the buttons are go-on and stop rather than agree-and-continue. -->
    <TextBlock Grid.Row="3" x:Name="WhatToDoText" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                Margin="0,12,0,0">
      <Button x:Name="StopButton" Content="Stop" Click="OnStop" IsCancel="True" />
      <Button x:Name="GoOnButton" Click="OnGoOn" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
