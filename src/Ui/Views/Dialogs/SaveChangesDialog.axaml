<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.SaveChangesDialog"
        Title="Save Changes"
        MinWidth="400"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20" MinHeight="100">

        <!-- MaxWidth is what makes TextWrapping mean anything here (owner, 2026-09-06: "the Rename
             Workspace dialog is crazy wide"). SizeToContent="WidthAndHeight" measures the text
             against infinite width, so Wrap never fires and the window grows to the longest LINE —
             invisible while every message was one short sentence, and the blast-radius confirmations
             this dialog now carries are paragraphs. Capped here rather than on the Window so a short
             message still sizes down to MinWidth on its own. -->
        <TextBlock Grid.Row="0"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   MaxWidth="460"
                   VerticalAlignment="Center"
                   FontSize="13"/>

        <!-- The message ran straight into the buttons' outlines with the two rows flush. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0"
                    Spacing="8">

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="70"
                    Padding="12,4"
                    Click="OnCancelClick"
                    FontSize="12"
                    HorizontalContentAlignment="Center"/>

            <Button x:Name="DontSaveButton"
                    Content="Don't Save"
                    MinWidth="70"
                    Padding="12,4"
                    Click="OnDontSaveClick"
                    FontSize="12"
                    HorizontalContentAlignment="Center"/>

            <Button x:Name="SaveButton"
                    Content="Save"
                    MinWidth="70"
                    Padding="12,4"
                    IsDefault="True"
                    Classes="accent"
                    Click="OnSaveClick"
                    FontSize="12"
                    HorizontalContentAlignment="Center"/>

        </StackPanel>

    </Grid>
</Window>
