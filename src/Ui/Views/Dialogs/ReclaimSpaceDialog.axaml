<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.ReclaimSpaceDialog"
        Title="Reclaim space"
        Width="480"
        SizeToContent="Height"
        MinHeight="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
      The confirmation for the one destructive control in the whole feature (revision-control.md
      §5.6a). It exists to say two things, and both of them are load-bearing:

        WHAT IS DESTROYED — states that have already been thinned, counted, with the age that
        selected them. After this nobody can bring them back, and that is stated in those words.

        WHAT SURVIVES — every restore point still listed, and every change the designer recorded
        themselves. Without that sentence this dialog reads as "delete my history?", which is the
        thing circuitRF specifically does not offer.

      The default button is CANCEL. Everywhere else in this dialog family the affirmative action is
      IsDefault; here it is not, because a return key pressed at the wrong moment must not be the
      gesture that destroys the only copy of something.
    -->

    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock x:Name="HeadlineLabel"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="DestroysLabel"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="SurvivesLabel"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="90"
                    FontSize="12"
                    IsCancel="True"
                    IsDefault="True"
                    HorizontalContentAlignment="Center"
                    Click="OnCancelClick"/>
            <Button x:Name="ReclaimButton"
                    Width="150"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    Click="OnReclaimClick"/>
        </StackPanel>
    </Grid>
</Window>
