<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:CircuitRF.Ui.Views.Dialogs"
        x:Class="CircuitRF.Ui.Views.Dialogs.KeepThisStateDialog"
        Title="Keep This State"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Margin="16" Spacing="10">

    <TextBlock Text="Keep this workspace as it is now, so you can come back to it."
               TextWrapping="Wrap" />

    <StackPanel Spacing="4">
      <TextBlock Text="What is this state? (optional)" FontSize="11" Opacity="0.75" />
      <TextBox x:Name="LabelBox" PlaceholderText="Widen the output match" />
      <!-- Same cut as KeepThisVersionDialog's, for the same reason and by the same instruction: the
           "six weeks from now…" sentence is the dialog arguing for itself. What a designer needs here
           is that the field is optional, which the label already says. -->
      <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                 Text="Without one it is listed as a save-point with its time." />
    </StackPanel>

    <!-- The large-file guard (revision-control.md §8.2). Present only when there is something over
         the threshold that is not already kept, so the ordinary save-point is one field and a
         button. -->
    <StackPanel x:Name="LargeFilesPanel" Spacing="6" IsVisible="False">
      <Separator />
      <TextBlock x:Name="LargeFilesHeading" TextWrapping="Wrap" FontWeight="SemiBold" />
      <!-- One line, not two: a multi-line Text="…" attribute keeps its own indentation as literal
           spaces (see KeepThisVersionDialog's note), which is what put a gap in the middle of a
           sentence. -->
      <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                 Text="These are much larger than a design document. Say what each one IS, not how it should be stored." />
      <ItemsControl x:Name="LargeFilesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="d:LargeFileRow">
            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Consequence}" FontSize="10" Opacity="0.9"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="230" VerticalAlignment="Top" Margin="8,0,0,0"
                        ItemsSource="{Binding Choices}"
                        SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button x:Name="KeepButton"   Content="Keep"   Click="OnKeep"   IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
