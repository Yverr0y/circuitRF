<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CircuitRF.Ui.Views.Dialogs.GitPathSettingsView">

  <!--
    The git circuitRF runs to keep a workspace's history — ONE control, TWO HOSTS, and which host it
    appears in is the whole of RC-4's R-rc4-3.

    The Revision Control tab is HIDDEN on a machine with no usable git and no configured path (§4.3):
    absence is silent, a designer who does not want this should never learn it exists, and hidden is
    deliberately not disabled — that is RC-6's HOLD state, which is a different thing. But "hide
    everything" would hide the one field that makes an unusually-located git findable in the first
    place, so when that tab is absent this same control is hosted on Security & Permissions instead,
    beside the Verilog-A compiler it is a near-copy of. It is never shown twice; SettingsView owns that.

    Security & Permissions is the right fallback host and not an arbitrary one: that tab answers what
    circuitRF is permitted to RUN, git is a program circuitRF runs, and the Verilog-A compiler row
    directly above is the same control with a different program — blank means PATH, a named path
    outranks PATH, Browse picks one from disk, and the status line reports what it found.

    Detect rather than Test: what a user with a problem needs to know is not only "does it work" but
    WHICH git answered and WHICH version, because "it says it can't find git" has to be answerable
    without a support call. A git below circuitRF's floor is reported HERE as too old, naming both
    versions — this is the one place that state is visible, because everywhere else in the application
    treats an under-floor git as absent (§4.7).
  -->

  <StackPanel Spacing="0">
    <TextBlock Text="Git" FontSize="11" FontWeight="SemiBold"
               Opacity="0.55" Margin="0,0,0,6" Name="SectionHeader"/>

    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
      <TextBox   Grid.Row="0" Grid.Column="0" Name="GitPathBox" FontSize="12"
                 PlaceholderText="Leave blank to use the git on PATH"
                 LostFocus="OnGitPathCommitted">
        <ToolTip.Tip>
          <TextBlock TextWrapping="Wrap" MaxWidth="360"
                     Text="circuitRF keeps a workspace's history by running git as a separate program. It bundles none and links to none. Leave this blank and the git on your PATH is used, which is what most machines want; the row is here for the machine that has two of them, or has one somewhere PATH does not reach. A git named here outranks PATH. This setting is shared by circuitRF, harmonicaRF and wBond."/>
        </ToolTip.Tip>
      </TextBox>
      <Button    Grid.Row="0" Grid.Column="1" Content="Browse…" FontSize="11"
                 Padding="8,3" Margin="6,0,0,0" Click="OnBrowseForGit"
                 ToolTip.Tip="Pick the git executable from disk"/>
      <Button    Grid.Row="0" Grid.Column="2" Content="Detect" FontSize="11"
                 Padding="8,3" Margin="6,0,0,0" Click="OnDetectGit"
                 ToolTip.Tip="Find it, and report the path and the version it identifies itself as"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" FontSize="11"
                 Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"
                 Name="GitStatusText" IsVisible="False" Text=""/>
    </Grid>
  </StackPanel>
</UserControl>
