<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.GerberArchiveOfferDialog"
        Title="Import Gerber — Look Inside the Archive?"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto" Margin="20,16,20,16">

        <TextBlock Grid.Row="0" x:Name="MessageText" FontSize="12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Don't Open" Width="110" FontSize="12" HorizontalContentAlignment="Center"
                    Click="OnDeclineClick"
                    ToolTip.Tip="Leave the archive alone. Nothing in this folder can be imported."/>
            <Button Content="Look Inside" x:Name="LookInsideButton" Width="110" IsDefault="True"
                    FontSize="12" HorizontalContentAlignment="Center" Click="OnAcceptClick"
                    ToolTip.Tip="Unpack it to a temporary folder, import from there, and delete it again."/>
        </StackPanel>

    </Grid>
</Window>
