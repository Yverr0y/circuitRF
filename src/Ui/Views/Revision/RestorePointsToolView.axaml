<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Revision.RestorePointsToolView"
             x:DataType="vm:RestorePointsTool"
             Background="{DynamicResource SystemChromeLowColor}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- The header toolbar, in the shape every other circuitRF panel header uses (the Analyses list
         and the Project panel are the two references): icon-only buttons, transparent, borderless,
         14 px glyphs in SystemBaseMediumColor, each one carrying its own sentence as a tooltip, with
         a hairline separator between what CREATES an entry and what ACTS ON the selected one.

         GLYPHS RATHER THAN WORDS, and the glyphs are the point here more than elsewhere. Three of the
         four actions began with the word "Keep" — keep this state, keep permanently, and, one panel
         over, keep this version — which read as three spellings of one operation and are not: one
         writes a restore point, one marks an existing restore point never to be tidied away, and one
         writes a titled version. The pin, the save-plus and (in the Versions panel) the tag say the
         difference at a glance in a way three "Keep" labels never did. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="0" Margin="4,4,4,2">

      <!-- The save-point lives on the File menu too (R-rc5-4c). It is here as well because this is
           where a designer is standing when they decide a state is worth keeping. -->
      <Button x:Name="SavePointButton" Click="OnSavePointClick"
              IsEnabled="{Binding HasWorkspace}"
              ToolTip.Tip="Keep this state — writes a restore point for the workspace as it stands, with a line saying what it is"
              Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
        <mi:MaterialIcon Kind="ContentSavePlusOutline" Width="14" Height="14"
                         Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </Button>

      <Border Width="1" Height="12" Margin="3,0,3,0" VerticalAlignment="Center"
              Background="{DynamicResource SystemBaseLowColor}"/>

      <Button x:Name="RestoreButton" Click="OnRestoreClick"
              IsEnabled="{Binding HasSelection}"
              ToolTip.Tip="Go back to this — puts the workspace back to the selected state. What you have now is kept first."
              Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
        <mi:MaterialIcon Kind="ArrowULeftTop" Width="14" Height="14"
                         Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </Button>

      <!-- A PIN, deliberately. The action does not create anything and it does not make a version: it
           marks the selected restore point so that tidying up never removes it. The row picks up the
           word "kept" on its right-hand side when it has worked. -->
      <Button x:Name="KeepButton" Click="OnKeepClick"
              IsEnabled="{Binding CanKeepPermanently}"
              ToolTip.Tip="Keep permanently — pins the selected restore point so tidying up never removes it. It stays a restore point; it does not become a version."
              Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
        <mi:MaterialIcon Kind="PinOutline" Width="14" Height="14"
                         Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </Button>

      <!-- R-rc6-4's way back. Shown only on a row retention tidied away, because on any other row it
           has nothing to do and a button that does nothing teaches nothing. -->
      <Button x:Name="BringBackButton" Click="OnBringBackClick"
              IsVisible="{Binding Selected.Thinned, FallbackValue=False}"
              ToolTip.Tip="Bring this back — returns a tidied-away state to the list"
              Padding="3,2" Background="Transparent" BorderThickness="0">
        <mi:MaterialIcon Kind="DeleteRestore" Width="14" Height="14"
                         Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </Button>
    </StackPanel>

    <!-- R-rc6-8. HELD MUST NOT LOOK LIKE ABSENT. RC-3 hides every affordance when git is missing,
         because absent is harmless; held is a designer who may believe they are protected. So the
         buttons above stay visible and REFUSE, and this line says why. A hidden button is
         indistinguishable from a feature that was never there.

         The remedy is deliberately NOT restated here (R-rc6-9's second cadence): it was said once, on
         open, and repeating it on every glance is how a message becomes noise. -->
    <TextBlock Grid.Row="1" Margin="6,2" FontSize="11" TextWrapping="Wrap"
               IsVisible="{Binding IsRecordingBlocked}"
               Text="{Binding RecordingState}" />

    <ListBox Grid.Row="2"
             x:Name="PointsList"
             ItemsSource="{Binding Points}"
             SelectedItem="{Binding Selected}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RestorePointRow">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
            <TextBlock Grid.Column="0" Text="{Binding When}" FontFamily="monospace"
                       Opacity="0.75" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Opacity="{Binding RowOpacity}">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Origin}" FontSize="10" Opacity="0.6" />
              <TextBlock Text="{Binding LeftOutSummary}" FontSize="10" Opacity="0.9"
                         IsVisible="{Binding IsIncomplete}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Mark}" FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center" IsVisible="{Binding HasMark}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- R-rc5-14. Said where it could mislead: "restore my workspace" sounds more total than it is,
         because content in a referenced workspace is not part of this workspace's history. -->
    <TextBlock Grid.Row="3" Margin="6,4" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
               Text="Going back brings back the files in this workspace. Anything in a workspace it
                     refers to, and any simulation results, are left exactly as they are." />
  </Grid>
</UserControl>
