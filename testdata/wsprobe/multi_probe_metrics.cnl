; multi_probe_metrics.cnl — the two_stage_terms.cnl circuit with one measure line per multi-probe
; derived metric (brief-wsprobe-3). Gate: the CLI as a process against the evaluator in process,
; and the stated cube shapes (tests/Ui.Tests/Cli/WsProbeGlobalCliTests.cs).
Term:T1     p1 0   Num=1 Z=50 Ohm
WSProbe:PS  p1 s1
R:RS1   s1 g1  R=10 Ohm
C:CG1   g1 0   C=0.5 pF
R:RG1   g1 0   R=500 Ohm
VCCS:M1 d1 0  g1 0  G=0.04
R:RO1   d1 0   R=400 Ohm
C:CD1   d1 0   C=0.3 pF
L:L12   d1x g2 L=2 nH
C:CG2   g2 0   C=0.4 pF
R:RG2   g2 0   R=300 Ohm
VCCS:M2 d2 0  g2 0  G=0.05
R:RO2   d2 0   R=300 Ohm
C:CF2   g2 d2  C=0.1 pF
C:CFB   s1 d2  C=0.05 pF
L:L2    d2 a2  L=1.5 nH
WSProbe:PL  a2 p2
Term:T2     p2 0   Num=2 Z=50 Ohm
WSProbe:P3  d1 d1x
analysis SP1 type=sparam start=1 stop=3 npts=21 Unit=GHz

; --- the probe pair (§5.1–5.4, E.5, E.6, E.8) --------------------------------
measure yp2   = wsp_yparam2(SP1.wsp, SP1.idx("PS"), SP1.idx("PL"))
measure yp2i  = wsp_yparam2(SP1.wsp, 1, 2, "inner")
measure yp2f  = wsp_yparam2(SP1.wsp, 1, 2, "feedback")
measure res   = wsp_yparam2_residual(SP1.wsp, 1, 2)
measure bc    = wsp_block_calc(SP1.wsp, 1, 2)
measure bc75  = wsp_block_calc(SP1.wsp, 1, 2, 75)
measure bb    = wsp_block_breakout(SP1.wsp, 1, 2)
measure fbb   = wsp_fb_breakout(SP1.wsp, 1, 2)
measure bd    = wsp_block_design(SP1.wsp, 1, 2)

; --- bifurcation (§6) — the document's four names and the side-explicit primitive ---
measure ybg   = wsp_bifurcate(SP1.wsp, "Y", "G", "PS")
measure ya    = wsp_YA(SP1.wsp, 1)
measure yf    = wsp_YF(SP1.wsp, 1)
measure za    = wsp_ZA(SP1.wsp, 1)
measure zf    = wsp_ZF(SP1.wsp, 1)

; --- Ohtomo (§7) and the loop-gain search --------------------------------------
measure oht   = wsp_loopgain_ohtomo(SP1.wsp, "PL")
measure ohtl  = wsp_loopgain_ohtomo(SP1.wsp, "PL", "L", 75)
measure lgf   = wsp_unstable_freq_loopgain(SP1.LG("P3"))

; --- the reduced matrices (§8) ---------------------------------------------------
measure ym    = wsp_ymatrix(SP1.wsp)
measure ym2   = wsp_ymatrix(SP1.wsp, "PS,P3")
measure ndf   = wsp_ndf(SP1.wsp, SP1.wsp)

; --- the envelope (§9) --------------------------------------------------------------
measure term  = wsp_terminate(SP1.wsp, SP1.idx("PS"), 1/complex(30,10), SP1.idx("PL"), 1/75)
measure lp    = wsp_loadpull(SP1.wsp, 1, 2, 3, "0.5:6", "0.3:4")
measure lpu   = wsp_loadpull_unstable(SP1.wsp, 1, 2, 3, "0.5:6", "0.3:4")
measure lpl   = wsp_loadpull(SP1.wsp, 0, 2, 3, 0, "0.6:8@15")
