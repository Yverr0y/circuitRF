; combiner_half.cnl — one half of combiner_even_mode.cnl with the common load DOUBLED.
; The classic even-mode reduction, and the oracle for R-wsp2-14(f): the load line at the drain
; probe here must equal the one the full combiner reports at either drain.
R:RSRC   s0 0    R=50 Ohm
WSProbe:P0  s0 ni

R:RIN    ni 0    R=1000 Ohm

VCCS:M1  d1 0  ni 0  G=0.05
R:RO1    d1 0    R=1000 Ohm
WSProbe:P1  d1 m1
R:RM1    m1 sum  R=5 Ohm

R:RL2    sum 0   R=50 Ohm

analysis SP1 type=sparam start=1 stop=3 npts=5 Unit=GHz
