    {
      "InstanceName": "MeasCarriers",
      "Symbol": "Meas",
      "X": -1800,
      "Y": 1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pin_avail_dBm",
          "Expression": "Pin                                          ; per tone",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_f1_W",
          "Expression": "real(0.5*HB1.V(\"Vout\",\"(1,0)\")*conj(HB1.I(\"Iout\",\"(1,0)\")))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_f1_dBm",
          "Expression": "10*log10(Pout_f1_W*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gt_dB",
          "Expression": "Pout_f1_dBm - Pin_avail_dBm                   ; gain on one carrier",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasIntermod",
      "Symbol": "Meas",
      "X": 700,
      "Y": 1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "IM2_dBc",
          "Expression": "dB(HB1.V(\"Vout\",\"(1,-1)\")) - dB(HB1.V(\"Vout\",\"(1,0)\"))   ; f1-f2",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IM3_lo_dBc",
          "Expression": "dB(HB1.V(\"Vout\",\"(2,-1)\")) - dB(HB1.V(\"Vout\",\"(1,0)\"))  ; 2f1-f2",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IM3_hi_dBc",
          "Expression": "dB(HB1.V(\"Vout\",\"(1,-2)\")) - dB(HB1.V(\"Vout\",\"(0,1)\"))  ; 2f2-f1, stored as its conjugate tag",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IM5_lo_dBc",
          "Expression": "dB(HB1.V(\"Vout\",\"(3,-2)\")) - dB(HB1.V(\"Vout\",\"(1,0)\"))  ; 3f1-2f2",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasDC",
      "Symbol": "Meas",
      "X": 2700,
      "Y": 1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "PDC_W",
          "Expression": "real(HB1.V(\"VDD\",\"(0,0)\")*HB1.I(\"IDC\",\"(0,0)\"))     ; DC is mix index (0,0)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Eff",
          "Expression": "2*Pout_f1_W/PDC_W*100                               ; both carriers",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
  ],
